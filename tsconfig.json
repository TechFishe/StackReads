{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@layouts/*": ["src/layouts/*.astro"],
      "@blocks/*": ["src/components/*.{astro,vue}"],
      "@astroBlocks/*": ["src/components/Astro/*.astro"],
      "@vueBlocks/*": ["src/components/Vue/*.vue"],
      "@firebase/*": ["src/firebase/*.ts"]
    }
  }
}
