---
import MainLayout from '@layouts/MainLayout';

const request = await fetch(`https://www.googleapis.com/books/v1/volumes/${Astro.params.id}`);
const book: any = await request.json();
console.log(book);
---

<MainLayout title={book.volumeInfo.title}>
  <main class="pt-[5.5rem] min-h-screen w-screen flex px-4 pb-2">
    <div class="flex w-full h-fit space-x-2">
      <img src={book.volumeInfo.imageLinks.thumbnail} alt="Book cover" class="rounded-sm h-60" />
      <section class="flex flex-col">
        <h1 class="text-5xl font-medium tracking-tight pb-3">{book.volumeInfo.title}</h1>
        <div class="flex border-t-2 border-t-SpringWood-50/35 w-fit pt-1 pr-8">
          <span class="text-xl tracking-tighter text-MonteCarlo-300">By:</span>
          <br />
          <span class="text-lg tracking-tighter italic font-Playpen">{book.volumeInfo.authors}</span>
        </div>
      </section>
      <section></section>
    </div>
  </main>
</MainLayout>
