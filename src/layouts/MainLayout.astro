---
import '@fontsource-variable/red-hat-mono';

import NavBtn from '@astroBlocks/NavBtn';
import NavIsland from '@vueBlocks/NavIsland';

interface Props {
  title: string;
}

const { title }: Props = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline src="https://kit.fontawesome.com/71e652acea.js" crossorigin="anonymous"></script>
    <title>StackReads | {title}</title>
  </head>
  <body class="bg-Woodsmoke-950 relative text-SpringWood-50 min-h-screen w-screen font-RedHat overflow-x-hidden">
    <header class="flex items-center absolute w-full backdrop-blur-[2px] h-20 px-4 py-1 border-b border-b-SpringWood-50/50">
      <section class="flex md:w-1/2 w-full items-center">
        <div class="hidden lg:flex lg:items-center">
          <i class="fa-light fa-books w-12 h-12 subpixel-antialiased mr-4"></i>
          <div class="border rounded-full border-SpringWood-50/50 h-10 w-0.5"></div>
        </div>
        <span class="lg:ml-4 text-6xl tracking-wide font-Playpen text-MonteCarlo-300 w-full text-center md:text-justify">StackReads</span>
      </section>
      <nav class="md:flex w-1/2 md:items-center md:justify-end md:space-x-8 hidden">
        <NavBtn text="Home" icon="house" url="/" />
        <NavBtn text="TBR" icon="bookmark" url="/user/tbr" />
        <NavBtn text="Search" icon="magnifying-glass" url="/search" />
        <NavBtn text="User" icon="user" url="/user" />
      </nav>
    </header>
    <slot />
    <NavIsland client:only="vue">
      <NavBtn text="Home" icon="house" url="/" />
      <NavBtn text="TBR" icon="bookmark" url="/user/tbr" />
      <NavBtn text="Search" icon="magnifying-glass" url="/search" />
      <NavBtn text="User" icon="user" url="/user" />
    </NavIsland>
    <footer class="border-t border-t-SpringWood-50/50 px-4 py-1 h-[2.5rem] relative flex items-center justify-center">
      <span>Made with 💙 by Jacob Barker</span>
    </footer>
  </body>
</html>
