---
import '@fontsource-variable/playpen-sans';

interface Props {
  text: string;
  icon: string;
  url: string;
}

const { text, icon, url }: Props = Astro.props;
---

<a href={url} class="group p-1.5 flex items-center justify-center space-x-2 relative hover:scale-110 transition-transform ease-in">
  <i class=`fa-light fa-${icon} h-8 w-8 md:h-[2.5rem] md:w-[2.5rem] subpixel-antialiased group-hover:text-MonteCarlo-300 transition-colors ease-in`></i>
  <span class="font-thin font-Playpen text-[10px] bg-Woodsmoke-800 px-0.5 rounded absolute origin-center object-center top-[3.5rem] right-1/2 scale-0 group-hover:scale-100 transition-transform ease-linear duration-100 delay-150 group-hover:delay-700 translate-x-1/2 border-SpringWood-50/50 border">{text}</span>
</a>
